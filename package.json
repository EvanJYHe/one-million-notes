{
  "name": "one-million-notes",
  "version": "0.1.0",
  "private": true,
  "description": "A collaborative message wall for collecting one million notes.",
  "author": "Evan He",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvanJYHe/one-million-notes.git"
  },
  "homepage": "https://one-million-notes.evan-he24.workers.dev",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "check": "npm run typecheck && npm run lint && npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate-seed": "node scripts/generate-d1-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply one-million-notes --local",
    "db:migrate:remote": "wrangler d1 migrations apply one-million-notes --remote"
  },
  "dependencies": {
    "@fontsource-variable/dynapuff": "^5.3.0",
    "@fontsource/architects-daughter": "^5.1.1",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/gloria-hallelujah": "^5.1.1",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/schoolbell": "^5.3.0",
    "next": "^15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-virtualized-auto-sizer": "^1.0.25",
    "react-window": "^1.8.11",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "eslint": "^9",
    "eslint-config-next": "^15.5.21",
    "typescript": "^5.7.3",
    "wrangler": "^4.116.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
